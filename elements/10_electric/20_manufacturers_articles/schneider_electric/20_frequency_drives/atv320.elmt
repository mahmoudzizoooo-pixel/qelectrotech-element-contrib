
<?xml version="1.0" encoding="UTF-8"?>
<definition
    link_type="master"
    width="120"
    height="145"
    hotspot_x="60"
    hotspot_y="72"
    type="element"
    version="0.70">

    <uuid>{8d944540-f0d9-4a20-892c-61d5c2e585fa}</uuid>

    <name lang="en">ATV320 Front View</name>
    <name lang="fr">ATV320 Vue de face</name>
    <name lang="de">ATV320 Vorderansicht</name>

    <kind type="protection"/>

    <manufacturer>Schneider Electric</manufacturer>

    <description>
        <rect x="-57" y="-68" width="114" height="132"
              fill="#35383B" stroke="#242629" stroke_width="1.2"/>

        <!-- Upper housing -->
        <polygon points="-57,-68 47,-68 57,-60 -48,-60"
                 fill="#55595D" stroke="#303336" stroke_width="0.8"/>

        <!-- Left housing side -->
        <polygon points="-57,-68 -48,-60 -48,64 -57,55"
                 fill="#292C2F" stroke="#242629" stroke_width="0.8"/>

        <!-- Right housing edge -->
        <polygon points="47,-68 57,-60 57,55 47,64"
                 fill="#45494D" stroke="#242629" stroke_width="0.8"/>

        <!-- Lower housing edge -->
        <polygon points="-57,55 -48,64 47,64 57,55"
                 fill="#292C2F" stroke="#242629" stroke_width="0.8"/>

        <!-- Front control-panel surround -->
        <polygon points="-1,-48 44,-48 49,-43 49,42 -1,42"
                 fill="#222629" stroke="#151719" stroke_width="1"/>

        <!-- Display bezel -->
        <rect x="2" y="-44" width="43" height="24"
              fill="#101315" stroke="#777B7E" stroke_width="0.7"/>

        <!-- LCD display -->
        <rect x="7" y="-39" width="32" height="13"
              fill="#25292B" stroke="#55595C" stroke_width="0.5"/>

        <!-- Seven-segment display approximation -->
        <text x="23" y="-29" font_size="9" text_anchor="middle"
              fill="#A85F61">8.8.8.8.8</text>

        <!-- Display legends -->
        <text x="5" y="-40" font_size="2.2" fill="#D3D3D3">Ref</text>
        <text x="5" y="-36" font_size="2.2" fill="#D3D3D3">Mon</text>
        <text x="5" y="-32" font_size="2.2" fill="#D3D3D3">Conf</text>
        <text x="34" y="-40" font_size="2.2" fill="#D3D3D3">RUN</text>
        <text x="34" y="-36" font_size="2.2" fill="#D3D3D3">STOP</text>

        <!-- ESC button -->
        <rect x="3" y="-17" width="11" height="10" rx="1"
              fill="#17191A" stroke="#666A6D" stroke_width="0.7"/>
        <text x="8.5" y="-11" font_size="3.6"
              text_anchor="middle" fill="#F0F0F0">ESC</text>

        <!-- Green navigation dial -->
        <circle cx="28" cy="-12" r="11"
                fill="#079B45" stroke="#006B30" stroke_width="1"/>
        <circle cx="28" cy="-12" r="8.8"
                fill="#0BBE57" stroke="#2DDA70" stroke_width="0.6"/>
        <circle cx="28" cy="-12" r="5.2"
                fill="#08A84B" stroke="#06863D" stroke_width="0.4"/>

        <!-- Rectangular blank panel -->
        <rect x="3" y="2" width="39" height="12"
              fill="#303437" stroke="#202326" stroke_width="0.6"/>

        <!-- Warning label -->
        <rect x="3" y="19" width="18" height="10"
              fill="#E4E4E0" stroke="#B6B6B0" stroke_width="0.4"/>
        <polygon points="4,20 9,20 6.5,24"
                 fill="#E53935"/>
        <text x="12" y="23" font_size="3.2"
              text_anchor="middle" fill="#C92525">DANGER</text>
        <text x="12" y="27" font_size="2.1"
              text_anchor="middle" fill="#252525">WARNING</text>

        <!-- Product information label -->
        <rect x="23" y="20" width="17" height="9"
              fill="#F1F1ED" stroke="#A9AAA6" stroke_width="0.4"/>
        <text x="31.5" y="24" font_size="2.2"
              text_anchor="middle" fill="#222222">Altivar</text>
        <text x="31.5" y="27" font_size="2.2"
              text_anchor="middle" fill="#222222">ATV320</text>

        <!-- QR code -->
        <rect x="35" y="-17" width="9" height="12"
              fill="#FFFFFF" stroke="#D6D6D6" stroke_width="0.4"/>
        <rect x="36" y="-16" width="3" height="3" fill="#111111"/>
        <rect x="40" y="-16" width="3" height="3" fill="#111111"/>
        <rect x="36" y="-12" width="3" height="3" fill="#111111"/>
        <rect x="40" y="-12" width="1" height="1" fill="#111111"/>
        <rect x="42" y="-10" width="1" height="2" fill="#111111"/>
        <rect x="39" y="-9" width="2" height="2" fill="#111111"/>
        <rect x="36" y="-8" width="2" height="2" fill="#111111"/>

        <!-- Right-side detail -->
        <rect x="49" y="-2" width="2" height="29"
              fill="#303437" stroke="#202326" stroke_width="0.4"/>
        <line x1="49.5" y1="2" x2="50.5" y2="2"
              stroke="#74787A" stroke_width="0.5"/>
        <line x1="49.5" y1="6" x2="50.5" y2="6"
              stroke="#74787A" stroke_width="0.5"/>

        <!-- Bottom feet / housing details -->
        <polygon points="-48,53 -41,58 -41,64 -48,64"
                 fill="#242729"/>
        <polygon points="40,58 47,53 47,64 40,64"
                 fill="#242729"/>

    </description>
</definition>
