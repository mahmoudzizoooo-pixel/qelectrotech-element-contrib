
<definition link_type="master" width="100" height="180" hotspot_x="50" hotspot_y="90" type="element" version="0.70">
    <uuid uuid="{8d944540-f0d9-4a20-892c-61d5c2e585fa}"/>
    <names>
        <name lang="en">ATV320 Front View</name>
        <name lang="pl">ATV320 Front View</name>
        <name lang="cs">ATV320 Front View</name>
        <name lang="el">ATV320 Front View</name>
        <name lang="it">ATV320 Front View</name>
        <name lang="fr">ATV320 Front View</name>
        <name lang="nl">ATV320 Front View</name>
    </names>
    <kindInformations>
        <kindInformation name="type" show="1">protection</kindInformation>
    </kindInformations>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">SCHNEIDER ELECTRIC</elementInformation>
    </elementInformations>
    <informations></informations>
    <description>
        <!-- Main drive housing -->
        <rect x="-40" y="-75" width="80" height="150"
            style="line-style:normal;line-weight:normal;filling:none;color:black"
            antialias="true" rx="2" ry="2"/>

        <!-- Upper front panel -->
        <rect x="-30" y="-65" width="60" height="38"
            style="line-style:normal;line-weight:normal;filling:none;color:black"
            antialias="true" rx="1" ry="1"/>

        <!-- Display bezel -->
        <rect x="-23" y="-59" width="46" height="20"
            style="line-style:normal;line-weight:normal;filling:none;color:black"
            antialias="true" rx="1" ry="1"/>

        <!-- Display -->
        <rect x="-19" y="-55" width="38" height="12"
            style="line-style:normal;line-weight:normal;filling:none;color:black"
            antialias="true" rx="1" ry="1"/>

        <!-- Display indication lines -->
        <line x1="-15" y1="-51" x2="3" y2="-51"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>
        <line x1="-15" y1="-47" x2="12" y2="-47"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>

        <!-- Status indicator -->
        <circle x="24" y="-20" diameter="4"
            style="line-style:normal;line-weight:normal;filling:none;color:black"
            antialias="true"/>

        <!-- Control buttons -->
        <circle x="-18" y="-19" diameter="9"
            style="line-style:normal;line-weight:normal;filling:none;color:black"
            antialias="true"/>
        <circle x="9" y="-19" diameter="9"
            style="line-style:normal;line-weight:normal;filling:none;color:black"
            antialias="true"/>
        <circle x="-18" y="-2" diameter="9"
            style="line-style:normal;line-weight:normal;filling:none;color:black"
            antialias="true"/>
        <circle x="9" y="-2" diameter="9"
            style="line-style:normal;line-weight:normal;filling:none;color:black"
            antialias="true"/>

        <!-- Navigation control -->
        <circle x="-4.5" y="16" diameter="18"
            style="line-style:normal;line-weight:normal;filling:none;color:black"
            antialias="true"/>
        <circle x="-4.5" y="16" diameter="7"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>

        <!-- Navigation direction marks -->
        <line x1="-4.5" y1="8" x2="-4.5" y2="11"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>
        <line x1="-4.5" y1="21" x2="-4.5" y2="24"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>
        <line x1="-13" y1="16" x2="-10" y2="16"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>
        <line x1="1" y1="16" x2="4" y2="16"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>

        <!-- Front ventilation slots -->
        <line x1="-25" y1="38" x2="25" y2="38"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>
        <line x1="-25" y1="43" x2="25" y2="43"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>
        <line x1="-25" y1="48" x2="25" y2="48"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>
        <line x1="-25" y1="53" x2="25" y2="53"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>

        <!-- Lower identification panel -->
        <rect x="-29" y="59" width="58" height="10"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true" rx="0" ry="0"/>

        <text x="-19" y="66" size="6" text="ATV320"/>

        <!-- Mounting points -->
        <circle x="-35" y="-70" diameter="3"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>
        <circle x="35" y="-70" diameter="3"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>
        <circle x="-35" y="70" diameter="3"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>
        <circle x="35" y="70" diameter="3"
            style="line-style:normal;line-weight:thin;filling:none;color:black"
            antialias="true"/>
    </description>
</definition>
